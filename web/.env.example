# ============================================================================
# Dashboard — variables de entorno
# ============================================================================
# Copia a `web/.env.local` (ignorado por git) para desarrollo.
# En producción, GitHub Actions las inyecta desde las "Variables" del repo.
#
# SIN ESTAS VARIABLES EL DASHBOARD ARRANCA EN MODO DEMO, con datos simulados en
# el navegador. Es intencional: permite `npm run dev` en un clon limpio y ver el
# sistema funcionando sin backend ni hardware.
# ============================================================================

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave PÚBLICA por diseño: viaja dentro del bundle. Su seguridad no depende de
# ocultarla sino de las políticas RLS (migración 0002), que solo conceden
# lectura. NUNCA poner aquí la service_role.
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

VITE_DEVICE_SLUG=planta-01
