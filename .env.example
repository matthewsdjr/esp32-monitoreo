# ============================================================================
# Plantilla de variables de entorno
# ============================================================================
# Copia este archivo a `.env` y complétalo. `.env` está en .gitignore y NUNCA
# debe llegar al repositorio: es público.
#
#   cp .env.example .env
# ============================================================================

# --- Proyecto Supabase ------------------------------------------------------
# Dashboard → Settings → API
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública. Va incrustada en el dashboard; su seguridad depende de RLS,
# no de mantenerla oculta.
SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# ⚠ CRÍTICO: omite RLS por completo. Solo para scripts de administración y
# variables de entorno de Edge Functions. Jamás en el frontend ni en el firmware.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Settings → API → JWT Secret. Solo lo necesita emitir-jwt.mjs.
SUPABASE_JWT_SECRET=TU_JWT_SECRET_AQUI


# --- Administración del proyecto (solo para el alta inicial) ----------------
# Token de acceso personal: https://supabase.com/dashboard/account/tokens
# Permite aplicar migraciones y desplegar Edge Functions sin login interactivo.
SUPABASE_ACCESS_TOKEN=

# Referencia del proyecto: la parte xxxx de https://xxxx.supabase.co
SUPABASE_PROJECT_REF=

# Contraseña de la base de datos, la que se mostró al crear el proyecto.
# Si se perdió: Settings -> Database -> Reset database password
SUPABASE_DB_PASSWORD=

# --- Credenciales del equipo ------------------------------------------------
DEVICE_SLUG=planta-01

# Lo genera tools/scripts/registrar-equipo.mjs (se muestra una sola vez).
DEVICE_TOKEN=TU_DEVICE_TOKEN_AQUI

# Lo genera tools/scripts/emitir-jwt.mjs. Autoriza a publicar en el canal
# de tiempo real del equipo.
DEVICE_JWT=TU_DEVICE_JWT_AQUI

# --- Notificaciones (todas opcionales) --------------------------------------
# Si se dejan vacías, simplemente no se notifica por ese canal. El histórico y
# el registro de alarmas funcionan igual.

# Telegram: crea un bot con @BotFather y obtén el chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Correo vía Resend (3 000 correos/mes gratis)
RESEND_API_KEY=
CORREO_ORIGEN=alertas@tudominio.com
CORREO_DESTINO=supervisor@empresa.com,jefe@empresa.com

# URL pública del dashboard, para incluir el enlace en las notificaciones
URL_DASHBOARD=https://TU_USUARIO.github.io/esp32-monitoreo/
